DATABASE_URL=postgresql+psycopg://phishing:phishing@localhost:5432/phishing_detection
INGESTION_DIRECTORY=./data/inbox
MAX_EML_SIZE_BYTES=10485760
EMAIL_INFERENCE_DIRECTORY=./Tan Files
EMAIL_INFERENCE_MODULE=Email_Inference.py
# Optional override; defaults to EMAIL_INFERENCE_DIRECTORY/phishing_model.joblib
EMAIL_MODEL_PATH=
ENABLE_EMAIL_NLP=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
ENABLE_POLLING=false
POLL_INTERVAL_SECONDS=30
ARTIFACT_DIRECTORY=./data/artifacts
BROWSER_TIMEOUT_MS=15000
BROWSER_MAX_REDIRECTS=10
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=1000
